# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Session Encryption Secret
SESSION_SECRET=super_secret_airbnb_session_key_production_random_hash_987654321

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
# For local Postgres (default username: postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb?schema=public"
