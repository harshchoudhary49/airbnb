# ==========================================
# Airbnb Application Environment Variables
# ==========================================

# Server Port (Auto-assigned by cloud hosts like Render/Railway)
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# Session Encryption Secret (Use a long random string in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=super_secret_airbnb_session_key_production_random_hash_987654321

# PostgreSQL Connection String
# Local Postgres format:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb?schema=public"
# Cloud Postgres format (e.g., Supabase / Neon / Render Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb?schema=public"
