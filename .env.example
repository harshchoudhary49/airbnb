# Server port
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=production

# Session secret (use a long random string in production)
SESSION_SECRET=super_secret_airbnb_session_key_production_random_hash_987654321

# Database connection URL
# Local: postgresql://postgres:postgres@localhost:5432/airbnb?schema=public
# Cloud: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/airbnb?schema=public"
