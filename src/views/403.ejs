<%- include('partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('partials/nav') %>
    <main class="container mx-auto px-4 py-20 text-center max-w-lg">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-10">
        <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
          <i class="fas fa-lock"></i>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Host Access Required</h1>
        <p class="text-gray-500 mb-8"><%= typeof message !== 'undefined' ? message : 'This area is reserved for registered Airbnb Hosts.' %></p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/"
            class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 px-5 rounded-xl transition"
            >Back to Home</a
          >
          <a
            href="/signup"
            class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 px-5 rounded-xl transition shadow"
            >Create Host Account</a
          >
        </div>
      </div>
    </main>
    <footer class="bg-white border-t border-gray-200 py-6 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved</p>
      </div>
    </footer>
  </body>
</html>
