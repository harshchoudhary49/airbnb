<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-2xl">
      <div class="mb-6">
        <a href="/host/host-home-list" class="inline-flex items-center text-sm font-semibold text-gray-600 hover:text-red-500 transition">
          <i class="fas fa-arrow-left mr-2"></i> Back to Host Dashboard
        </a>
      </div>

      <div class="bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
        <div class="bg-red-500 text-white p-6">
          <h1 class="text-2xl font-bold">Edit Listing Details</h1>
          <p class="text-red-100 text-sm mt-1">Update your property information, rates, and imagery</p>
        </div>

        <form action="/host/edit-home" method="POST" class="p-6 md:p-8 space-y-5">
          <input type="hidden" name="id" value="<%= home.id %>" />

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Property Name *</label>
            <input
              type="text"
              name="houseName"
              value="<%= home.houseName %>"
              required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Price Per Night (₹) *</label>
              <input
                type="number"
                name="price"
                value="<%= home.price %>"
                required
                min="100"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">City / Location *</label>
              <input
                type="text"
                name="location"
                value="<%= home.location %>"
                required
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Rating (1.0 - 5.0) *</label>
              <input
                type="number"
                name="rating"
                step="0.1"
                min="1"
                max="5"
                value="<%= home.rating %>"
                required
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Photo Image URL *</label>
              <input
                type="url"
                name="photoUrl"
                value="<%= home.photoUrl %>"
                required
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Property Description</label>
            <textarea
              name="description"
              rows="3"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
            ><%= home.description || '' %></textarea>
          </div>

          <div class="flex gap-4 pt-3">
            <a 
              href="/host/host-home-list" 
              class="w-1/3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-4 rounded-xl text-center transition">
              Cancel
            </a>
            <button
              type="submit"
              class="w-2/3 bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2">
              <i class="fas fa-save"></i> Save Changes
            </button>
          </div>
        </form>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
      </div>
    </footer>
  </body>
</html>
