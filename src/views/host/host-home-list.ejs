<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-6xl">
      <!-- Top Bar -->
      <div class="flex flex-col sm:flex-row justify-between items-center bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8 gap-4">
        <div>
          <h1 class="text-3xl text-gray-900 font-extrabold tracking-tight">
            Host Dashboard
          </h1>
          <p class="text-gray-500 mt-1">Manage your active property listings, pricing, and details</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a 
            href="/spend-analyzer?tab=revenue" 
            class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-4 rounded-xl shadow transition duration-200 flex items-center gap-2 text-sm">
            <i class="fas fa-chart-line"></i> View Revenue & Analytics
          </a>
          <a 
            href="/host/add-home" 
            class="bg-red-500 hover:bg-red-600 text-white font-bold py-2.5 px-5 rounded-xl shadow transition duration-200 flex items-center gap-2 text-sm">
            <i class="fas fa-plus"></i> Add New Listing
          </a>
        </div>
      </div>

      <% if (!registeredHomes || registeredHomes.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center max-w-xl mx-auto">
          <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
            <i class="fas fa-home"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">No properties listed yet</h2>
          <p class="text-gray-500 mb-6">Earn extra income and unlock new opportunities by becoming a host on Airbnb.</p>
          <a href="/host/add-home" class="inline-block bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-xl shadow transition duration-200">
            Create Your First Listing
          </a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group border border-gray-100">
              <div class="relative overflow-hidden h-52">
                <img 
                  src="<%= home.photoUrl %>" 
                  alt="<%= home.houseName %>" 
                  onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=500';"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />
                <div class="absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2.5 py-1 rounded-md backdrop-blur-sm">
                  <i class="fas fa-map-marker-alt text-red-400 mr-1"></i><%= home.location %>
                </div>
              </div>

              <div class="p-5 flex flex-col flex-grow justify-between">
                <div>
                  <div class="flex justify-between items-start mb-1">
                    <h3 class="text-lg font-bold text-gray-900 line-clamp-1"><%= home.houseName %></h3>
                    <div class="flex items-center text-sm font-semibold text-gray-800 ml-2">
                      <i class="fas fa-star text-yellow-400 mr-1"></i>
                      <span><%= (home.rating && home.rating !== 'New') ? home.rating : 'New' %></span>
                    </div>
                  </div>
                  <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= home.description || 'Verified property listing with complete host privileges.' %></p>
                </div>

                <div>
                  <div class="text-lg font-bold text-red-500 mb-4">
                    ₹<%= Number(home.price).toLocaleString('en-IN') %> <span class="text-xs text-gray-500 font-normal">/ night</span>
                  </div>

                  <div class="grid grid-cols-2 gap-2 pt-2 border-t border-gray-100">
                    <a 
                      href="/host/edit-home/<%= home.id %>" 
                      class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded-lg text-center transition text-sm flex items-center justify-center gap-1.5">
                      <i class="fas fa-edit text-xs text-gray-600"></i> Edit
                    </a>
                    
                    <form 
                      action="/host/delete-home" 
                      method="POST" 
                      onsubmit="return confirm('Are you sure you want to permanently delete this listing?');"
                      class="w-full">
                      <input type="hidden" name="homeId" value="<%= home.id %>" />
                      <button 
                        type="submit" 
                        class="w-full bg-red-50 hover:bg-red-100 text-red-600 font-semibold py-2 px-3 rounded-lg text-center transition text-sm flex items-center justify-center gap-1.5">
                        <i class="fas fa-trash-alt text-xs"></i> Delete
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
      </div>
    </footer>
  </body>
</html>