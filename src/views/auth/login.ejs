<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-12 max-w-md">
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="bg-red-500 text-white p-6 text-center">
          <i class="fa-brands fa-airbnb text-4xl mb-2"></i>
          <h1 class="text-2xl font-bold">Welcome Back to Airbnb</h1>
          <p class="text-red-100 text-sm mt-1">Log in to manage your stays and bookings</p>
        </div>

        <div class="p-6 md:p-8">
          <% if (typeof infoMessage !== 'undefined' && infoMessage) { %>
            <div class="mb-5 p-3.5 bg-blue-50 border border-blue-200 text-blue-700 text-sm rounded-xl flex items-center gap-2">
              <i class="fas fa-info-circle text-blue-500"></i>
              <span><%= infoMessage %></span>
            </div>
          <% } %>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="mb-5 p-3.5 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl flex items-center gap-2">
              <i class="fas fa-exclamation-circle text-red-500"></i>
              <span><%= errorMessage %></span>
            </div>
          <% } %>

          <form action="/login" method="POST" class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Email Address</label>
              <input
                type="email"
                id="loginEmail"
                name="email"
                required
                value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
                placeholder="you@example.com"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
              />
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Password</label>
              <input
                type="password"
                id="loginPassword"
                name="password"
                required
                placeholder="••••••••"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
              />
            </div>

            <button
              type="submit"
              class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-xl shadow transition duration-200 text-base">
              Log In
            </button>
          </form>

          <!-- Interactive Demo Credentials Helper -->
          <div class="mt-6 pt-6 border-t border-gray-100">
            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Click to Quick-Fill Demo Account:</h4>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button 
                type="button" 
                onclick="fillDemo('host@airbnb.com', 'password123')"
                class="bg-gray-50 hover:bg-red-50 hover:border-red-300 p-2.5 rounded-lg border border-gray-200 text-left transition cursor-pointer group">
                <span class="font-bold text-gray-800 group-hover:text-red-600 block"><i class="fas fa-user-shield text-red-500 mr-1"></i>Host Demo</span>
                <span class="text-gray-500 block truncate">host@airbnb.com</span>
                <span class="text-gray-400 block font-mono text-[11px]">password123</span>
              </button>
              <button 
                type="button" 
                onclick="fillDemo('guest@airbnb.com', 'password123')"
                class="bg-gray-50 hover:bg-blue-50 hover:border-blue-300 p-2.5 rounded-lg border border-gray-200 text-left transition cursor-pointer group">
                <span class="font-bold text-gray-800 group-hover:text-blue-600 block"><i class="fas fa-user text-blue-500 mr-1"></i>Guest Demo</span>
                <span class="text-gray-500 block truncate">guest@airbnb.com</span>
                <span class="text-gray-400 block font-mono text-[11px]">password123</span>
              </button>
            </div>
          </div>

          <div class="mt-6 text-center text-sm text-gray-600">
            Don't have an account? 
            <a href="/signup" class="text-red-500 hover:underline font-semibold">Sign up</a>
          </div>
        </div>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved</p>
      </div>
    </footer>

    <script>
      function fillDemo(email, password) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = password;
      }
    </script>
  </body>
</html>
