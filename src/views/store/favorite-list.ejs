<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-6xl">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900">Your Wishlists & Favorites</h1>
        <p class="text-gray-500 mt-1">Saved stays that caught your eye</p>
      </div>

      <% if (!registeredHomes || registeredHomes.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center max-w-xl mx-auto">
          <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
            <i class="far fa-heart"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Your wishlist is empty</h2>
          <p class="text-gray-500 mb-6">As you search, tap the heart icon on any listing to save your favorite places.</p>
          <a href="/homes" class="inline-block bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-xl shadow transition duration-200">
            Explore Places
          </a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group border border-gray-100">
              <div class="relative overflow-hidden h-52">
                <a href="/homes/<%= home.id %>">
                  <img 
                    src="<%= home.photoUrl %>" 
                    alt="<%= home.houseName %>" 
                    onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=500';"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />
                </a>

                <!-- Remove Favorite Button -->
                <form action="/favorites/remove" method="POST" class="absolute top-3 right-3">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="homeId" value="<%= home.id %>" />
                  <button 
                    type="submit" 
                    title="Remove from favorites"
                    class="w-9 h-9 rounded-full bg-white shadow flex items-center justify-center transition hover:bg-red-50">
                    <i class="fas fa-heart text-lg text-red-500"></i>
                  </button>
                </form>

                <div class="absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2.5 py-1 rounded-md backdrop-blur-sm">
                  <i class="fas fa-map-marker-alt text-red-400 mr-1"></i><%= home.location %>
                </div>
              </div>

              <div class="p-5 flex flex-col flex-grow justify-between">
                <div>
                  <div class="flex justify-between items-start mb-1">
                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-red-500 transition line-clamp-1">
                      <a href="/homes/<%= home.id %>"><%= home.houseName %></a>
                    </h3>
                    <div class="flex items-center text-sm font-semibold text-gray-800 ml-2">
                      <i class="fas fa-star text-yellow-400 mr-1"></i>
                      <span><%= (home.rating && home.rating !== 'New') ? home.rating : 'New' %></span>
                    </div>
                  </div>
                  <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= home.description || 'Charming property with modern decor, comfortable bedding, and convenient access to local attractions.' %></p>
                </div>

                <div>
                  <div class="text-lg font-bold text-red-500 mb-4">
                    ₹<%= Number(home.price).toLocaleString('en-IN') %> <span class="text-xs text-gray-500 font-normal">/ night</span>
                  </div>

                  <div class="grid grid-cols-2 gap-2">
                    <a 
                      href="/homes/<%= home.id %>" 
                      class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded-lg text-center transition text-sm flex items-center justify-center gap-1">
                      <i class="fas fa-info-circle text-xs"></i> Details
                    </a>
                    <a 
                      href="/reserve/<%= home.id %>" 
                      class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-3 rounded-lg text-center transition text-sm shadow flex items-center justify-center gap-1">
                      <i class="fas fa-calendar-alt text-xs"></i> Book Now
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
      </div>
    </footer>
  </body>
</html>