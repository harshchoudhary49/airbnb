<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-4xl">
      <div class="mb-6">
        <a href="/homes/<%= home.id %>" class="inline-flex items-center text-sm font-semibold text-gray-600 hover:text-red-500 transition">
          <i class="fas fa-arrow-left mr-2"></i> Back to listing
        </a>
      </div>

      <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
        <div class="bg-red-500 text-white p-6">
          <h1 class="text-2xl font-bold">Request to Book</h1>
          <p class="text-red-100 text-sm mt-1">Review your details and reserve your stay</p>
        </div>

        <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Left 2 Cols: Form -->
          <div class="md:col-span-2">
            <form action="/reserve" method="POST" id="bookingForm" class="space-y-4">
              <input type="hidden" name="homeId" value="<%= home.id %>" />
              <input type="hidden" name="houseName" value="<%= home.houseName %>" />
              <input type="hidden" name="price" id="homePrice" value="<%= home.price %>" />
              <input type="hidden" name="location" value="<%= home.location %>" />
              <input type="hidden" name="photoUrl" value="<%= home.photoUrl %>" />

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Your Full Name *</label>
                <input 
                  type="text" 
                  name="guestName" 
                  required 
                  value="<%= user && user.name ? user.name : '' %>"
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
                />
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Email Address *</label>
                <input 
                  type="email" 
                  name="guestEmail" 
                  required 
                  value="<%= user && user.email ? user.email : '' %>"
                  placeholder="name@example.com"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Check-in Date *</label>
                  <input 
                    type="date" 
                    name="checkIn" 
                    id="checkInInput"
                    required 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
                  />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Check-out Date *</label>
                  <input 
                    type="date" 
                    name="checkOut" 
                    id="checkOutInput"
                    required 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800"
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Number of Guests</label>
                <select 
                  name="guestsCount" 
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800">
                  <option value="1">1 Guest</option>
                  <option value="2" selected>2 Guests</option>
                  <option value="3">3 Guests</option>
                  <option value="4">4 Guests</option>
                  <option value="5+">5+ Guests</option>
                </select>
              </div>

              <div class="pt-4">
                <button 
                  type="submit" 
                  class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2 text-base">
                  <i class="fas fa-check-circle"></i> Confirm & Book Reservation
                </button>
              </div>
            </form>
          </div>

          <!-- Right Col: Booking Summary Card -->
          <div class="md:col-span-1">
            <div class="bg-gray-50 p-5 rounded-xl border border-gray-200">
              <img 
                src="<%= home.photoUrl %>" 
                alt="<%= home.houseName %>" 
                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=500';"
                class="w-full h-36 object-cover rounded-lg mb-3"
              />
              <h3 class="font-bold text-gray-900 line-clamp-1"><%= home.houseName %></h3>
              <p class="text-xs text-gray-500 mb-2"><i class="fas fa-map-marker-alt text-red-500 mr-1"></i><%= home.location %></p>
              
              <hr class="border-gray-200 my-3" />

              <h4 class="font-bold text-gray-800 text-sm mb-2">Price Breakdown</h4>
              <div class="space-y-2 text-sm text-gray-600">
                <div class="flex justify-between">
                  <span>Price per night</span>
                  <span class="font-medium text-gray-800">₹<%= Number(home.price).toLocaleString('en-IN') %></span>
                </div>
                <div class="flex justify-between">
                  <span>Nights</span>
                  <span id="nightsCountDisplay" class="font-medium text-gray-800">1 night</span>
                </div>
                <div class="flex justify-between border-t border-gray-200 pt-2 font-bold text-base text-gray-900">
                  <span>Total Amount</span>
                  <span id="totalPriceDisplay" class="text-red-500 font-extrabold">₹<%= Number(home.price).toLocaleString('en-IN') %></span>
                </div>
              </div>

              <div class="mt-4 p-3 bg-red-50 border border-red-100 rounded-lg text-xs text-red-600 flex items-start gap-2">
                <i class="fas fa-shield-alt text-red-500 mt-0.5"></i>
                <span>Free cancellation up to 48 hours before check-in.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
      </div>
    </footer>

    <script>
      // Preset sensible default dates (today and tomorrow)
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);

      const checkInInput = document.getElementById('checkInInput');
      const checkOutInput = document.getElementById('checkOutInput');
      const nightsCountDisplay = document.getElementById('nightsCountDisplay');
      const totalPriceDisplay = document.getElementById('totalPriceDisplay');
      const homePriceInput = document.getElementById('homePrice');
      const basePrice = Number(homePriceInput ? homePriceInput.value : 0) || 0;

      const formatDate = (date) => date.toISOString().split('T')[0];
      
      checkInInput.min = formatDate(today);
      checkInInput.value = formatDate(today);
      
      checkOutInput.min = formatDate(tomorrow);
      checkOutInput.value = formatDate(tomorrow);

      function updateCalculation() {
        const d1 = new Date(checkInInput.value);
        const d2 = new Date(checkOutInput.value);
        if (d2 > d1) {
          const diffDays = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));
          nightsCountDisplay.textContent = diffDays + (diffDays === 1 ? ' night' : ' nights');
          totalPriceDisplay.textContent = '₹' + (diffDays * basePrice).toLocaleString('en-IN');
        }
      }

      checkInInput.addEventListener('change', () => {
        const d1 = new Date(checkInInput.value);
        const nextDay = new Date(d1);
        nextDay.setDate(nextDay.getDate() + 1);
        checkOutInput.min = formatDate(nextDay);
        if (new Date(checkOutInput.value) <= d1) {
          checkOutInput.value = formatDate(nextDay);
        }
        updateCalculation();
      });

      checkOutInput.addEventListener('change', updateCalculation);
    </script>
  </body>
</html>
