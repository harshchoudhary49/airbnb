<%- include('../partials/head') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <style>
      .flatpickr-calendar {
        border-radius: 1.25rem !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
        border: 1px solid #f3f4f6 !important;
        font-family: inherit !important;
      }
      .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange {
        background: #ef4444 !important;
        border-color: #ef4444 !important;
        color: #ffffff !important;
      }
      .flatpickr-day.inRange {
        background: #fee2e2 !important;
        border-color: #fee2e2 !important;
        color: #991b1b !important;
      }
      .flatpickr-day.flatpickr-disabled, .flatpickr-day.flatpickr-disabled:hover {
        color: #d1d5db !important;
        background: #f9fafb !important;
        text-decoration: line-through !important;
        cursor: not-allowed !important;
      }
    </style>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-4xl">
      <div class="mb-6">
        <a href="/homes/<%= home.id %>" class="inline-flex items-center text-sm font-semibold text-gray-600 hover:text-red-500 transition">
          <i class="fas fa-arrow-left mr-2"></i> Back to listing
        </a>
      </div>

      <!-- Overlapping Booking / Availability Error Alert Banner -->
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-2xl shadow-sm text-red-800 flex items-start gap-3.5 animate-pulse">
          <i class="fas fa-circle-exclamation text-xl mt-0.5 text-red-500"></i>
          <div>
            <h4 class="font-bold text-sm">Dates Unavailable</h4>
            <p class="text-xs text-red-700 mt-0.5"><%= errorMessage %></p>
          </div>
        </div>
      <% } %>

      <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-r from-red-600 to-rose-500 text-white p-6">
          <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
            <i class="fas fa-calendar-check"></i> Instant Booking
          </div>
          <h1 class="text-2xl font-bold">Request to Book</h1>
          <p class="text-red-100 text-sm mt-1">Review live availability, choose your travel dates, and reserve your stay</p>
        </div>

        <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Left 2 Cols: Form -->
          <div class="md:col-span-2">
            <form action="/reserve" method="POST" id="bookingForm" class="space-y-5">
              <input type="hidden" name="homeId" value="<%= home.id %>" />
              <input type="hidden" name="houseName" value="<%= home.houseName %>" />
              <input type="hidden" name="price" id="homePrice" value="<%= home.price %>" />
              <input type="hidden" name="location" value="<%= home.location %>" />
              <input type="hidden" name="photoUrl" value="<%= home.photoUrl %>" />

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Your Full Name *</label>
                <input 
                  type="text" 
                  name="guestName" 
                  required 
                  value="<%= user && user.name ? user.name : '' %>"
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-sm shadow-sm"
                />
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Email Address *</label>
                <input 
                  type="email" 
                  name="guestEmail" 
                  required 
                  value="<%= user && user.email ? user.email : '' %>"
                  placeholder="name@example.com"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-sm shadow-sm"
                />
              </div>

              <!-- Date Picker Section with Live Flatpickr -->
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label class="block text-xs font-bold uppercase tracking-wider text-gray-700">Trip Dates *</label>
                  <span class="text-[11px] text-gray-400 font-medium">Booked dates are automatically grayed out</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="relative">
                    <label class="block text-xs text-gray-500 mb-1">Check-in Date</label>
                    <div class="relative">
                      <i class="fas fa-calendar-day absolute left-3.5 top-3 text-gray-400 text-sm pointer-events-none"></i>
                      <input 
                        type="text" 
                        name="checkIn" 
                        id="checkInInput"
                        required 
                        readonly
                        placeholder="Select check-in"
                        class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-sm bg-white cursor-pointer shadow-sm"
                      />
                    </div>
                  </div>

                  <div class="relative">
                    <label class="block text-xs text-gray-500 mb-1">Check-out Date</label>
                    <div class="relative">
                      <i class="fas fa-calendar-check absolute left-3.5 top-3 text-gray-400 text-sm pointer-events-none"></i>
                      <input 
                        type="text" 
                        name="checkOut" 
                        id="checkOutInput"
                        required 
                        readonly
                        placeholder="Select check-out"
                        class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-sm bg-white cursor-pointer shadow-sm"
                      />
                    </div>
                  </div>
                </div>

                <!-- Live Availability Legend -->
                <div class="flex items-center gap-4 mt-2.5 text-xs text-gray-500">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> Available
                  </span>
                  <span class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-gray-300 inline-block"></span> Already Booked
                  </span>
                  <% if (typeof bookedRanges !== 'undefined' && bookedRanges.length > 0) { %>
                    <span class="text-amber-600 font-medium">
                      <i class="fas fa-lock mr-1"></i><%= bookedRanges.length %> confirmed reservation<%= bookedRanges.length > 1 ? 's' : '' %>
                    </span>
                  <% } %>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">Number of Guests</label>
                <select 
                  name="guestsCount" 
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 text-gray-800 text-sm shadow-sm bg-white">
                  <option value="1">1 Guest</option>
                  <option value="2" selected>2 Guests</option>
                  <option value="3">3 Guests</option>
                  <option value="4">4 Guests</option>
                  <option value="5+">5+ Guests</option>
                </select>
              </div>

              <div class="pt-2">
                <button 
                  type="submit" 
                  id="submitBookingBtn"
                  class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2 text-base cursor-pointer">
                  <i class="fas fa-check-circle"></i> Confirm & Book Reservation
                </button>
              </div>
            </form>
          </div>

          <!-- Right Col: Booking Summary Card -->
          <div class="md:col-span-1">
            <div class="bg-gray-50 p-5 rounded-2xl border border-gray-200">
              <img 
                src="<%= home.photoUrl %>" 
                alt="<%= home.houseName %>" 
                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=500';"
                class="w-full h-36 object-cover rounded-xl mb-3 shadow-inner"
              />
              <h3 class="font-bold text-gray-900 line-clamp-1"><%= home.houseName %></h3>
              <p class="text-xs text-gray-500 mb-2"><i class="fas fa-map-marker-alt text-red-500 mr-1"></i><%= home.location %></p>
              
              <hr class="border-gray-200 my-3" />

              <h4 class="font-bold text-gray-800 text-xs uppercase tracking-wider mb-2.5">Price Breakdown</h4>
              <div class="space-y-2 text-sm text-gray-600">
                <div class="flex justify-between">
                  <span>Price per night</span>
                  <span class="font-medium text-gray-800">₹<%= Number(home.price).toLocaleString('en-IN') %></span>
                </div>
                <div class="flex justify-between">
                  <span>Duration</span>
                  <span id="nightsCountDisplay" class="font-medium text-gray-800">1 night</span>
                </div>
                <div class="flex justify-between border-t border-gray-200 pt-2 font-bold text-base text-gray-900">
                  <span>Total Amount</span>
                  <span id="totalPriceDisplay" class="text-red-500 font-extrabold">₹<%= Number(home.price).toLocaleString('en-IN') %></span>
                </div>
              </div>

              <div class="mt-4 p-3 bg-red-50 border border-red-100 rounded-xl text-xs text-red-700 flex items-start gap-2">
                <i class="fas fa-shield-alt text-red-500 mt-0.5"></i>
                <span>Free cancellation up to 48 hours before check-in. Protected by Airbnb Coverage.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
      </div>
    </footer>

    <!-- Safe JSON Data Block for Calendar Availability -->
    <script type="application/json" id="bookedRangesData">
      <%- JSON.stringify(typeof bookedRanges !== 'undefined' ? bookedRanges : []) %>
    </script>

    <!-- Flatpickr Date Picker Library -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
      // Load confirmed bookings from server to disable overlapping nights
      const bookedDataEl = document.getElementById('bookedRangesData');
      const bookedRangesRaw = bookedDataEl ? JSON.parse(bookedDataEl.textContent || '[]') : [];
      
      const disableDates = bookedRangesRaw.map(r => ({
        from: r.from,
        to: r.to
      }));

      const homePriceInput = document.getElementById('homePrice');
      const basePrice = Number(homePriceInput ? homePriceInput.value : 0) || 0;
      const nightsCountDisplay = document.getElementById('nightsCountDisplay');
      const totalPriceDisplay = document.getElementById('totalPriceDisplay');
      const checkInInput = document.getElementById('checkInInput');
      const checkOutInput = document.getElementById('checkOutInput');

      function updateCalculation() {
        if (!checkInInput.value || !checkOutInput.value) return;
        const d1 = new Date(checkInInput.value);
        const d2 = new Date(checkOutInput.value);
        if (d2 > d1) {
          const diffDays = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));
          nightsCountDisplay.textContent = diffDays + (diffDays === 1 ? ' night' : ' nights');
          totalPriceDisplay.textContent = '₹' + (diffDays * basePrice).toLocaleString('en-IN');
        }
      }

      // Initialize Flatpickr for Check-Out Date Picker
      const checkOutPicker = flatpickr("#checkOutInput", {
        dateFormat: "Y-m-d",
        minDate: new Date().fp_incr(1),
        disable: disableDates,
        onChange: function(selectedDates, dateStr) {
          updateCalculation();
        }
      });

      // Initialize Flatpickr for Check-In Date Picker
      const checkInPicker = flatpickr("#checkInInput", {
        dateFormat: "Y-m-d",
        minDate: "today",
        disable: disableDates,
        onChange: function(selectedDates, dateStr) {
          if (selectedDates.length > 0) {
            const nextDay = new Date(selectedDates[0]);
            nextDay.setDate(nextDay.getDate() + 1);
            checkOutPicker.set('minDate', nextDay);
            
            // If current checkOut is earlier than new checkIn, update it
            if (checkOutPicker.selectedDates.length === 0 || checkOutPicker.selectedDates[0] <= selectedDates[0]) {
              checkOutPicker.setDate(nextDay, true);
            } else {
              updateCalculation();
            }
          }
        }
      });

      // Auto-select first available date starting from today
      const now = new Date();
      checkInPicker.setDate(now, true);
    </script>
  </body>
</html>
