<%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-7xl flex-grow">
      
      <!-- Role-Based Navigation Pill Switcher (Visible to Hosts) -->
      <% if (typeof isHost !== 'undefined' && isHost) { %>
        <div class="flex items-center justify-center mb-6">
          <div class="inline-flex bg-gray-200/80 p-1.5 rounded-2xl shadow-inner gap-1 border border-gray-300/50">
            <button 
              id="tabSpendBtn" 
              onclick="switchTab('spend')" 
              class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 shadow-sm bg-white text-red-600 cursor-pointer"
            >
              <i class="fas fa-wallet"></i> My Travel Expenses
            </button>
            <button 
              id="tabRevenueBtn" 
              onclick="switchTab('revenue')" 
              class="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 text-gray-600 hover:text-gray-900 cursor-pointer"
            >
              <i class="fas fa-chart-line text-emerald-600"></i> Host Revenue & Earnings
              <span class="ml-1 bg-emerald-100 text-emerald-700 text-[10px] uppercase font-extrabold px-2 py-0.5 rounded-full">Host Mode</span>
            </button>
          </div>
        </div>
      <% } %>

      <!-- ========================================== -->
      <!-- TAB 1: GUEST TRAVEL SPEND ANALYZER        -->
      <!-- ========================================== -->
      <div id="spendViewSection">
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-red-600 via-rose-500 to-orange-500 rounded-3xl p-6 md:p-8 text-white shadow-lg mb-8 relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 opacity-10 text-white pointer-events-none">
            <i class="fa-solid fa-chart-pie text-9xl"></i>
          </div>

          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
            <div>
              <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
                <i class="fas fa-wallet"></i> Personal Travel Finance
              </div>
              <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">Travel Spend Analyzer</h1>
              <p class="text-red-100 text-sm md:text-base mt-1 max-w-2xl">
                Track your accommodation expenditures, monitor destination budgets, and optimize your travel costs across all bookings.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <% if (bookings && bookings.length > 0) { %>
                <a 
                  href="/spend-analyzer/export?type=spend" 
                  class="bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-md px-4 py-2.5 rounded-xl text-sm font-semibold flex items-center gap-2 transition duration-200 shadow-sm"
                  title="Download CSV report"
                >
                  <i class="fas fa-file-csv text-base"></i> Export Spend CSV
                </a>
              <% } %>
              <a 
                href="/homes" 
                class="bg-white text-red-600 hover:bg-gray-100 px-5 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 transition duration-200 shadow-sm"
              >
                <i class="fas fa-compass"></i> Explore Stays
              </a>
            </div>
          </div>
        </div>

        <% if (!bookings || bookings.length === 0) { %>
          <!-- Empty State -->
          <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-12 text-center max-w-xl mx-auto my-12">
            <div class="w-20 h-20 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center mx-auto mb-5 text-3xl shadow-inner">
              <i class="fas fa-chart-line"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">No Travel Spending Yet</h2>
            <p class="text-gray-500 mb-6 text-sm leading-relaxed">
              Your spend analytics, destination cost breakdowns, and budget tracking will automatically appear here once you reserve your first stay.
            </p>
            <a href="/homes" class="inline-flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition duration-200">
              <i class="fas fa-search"></i> Book Your First Stay
            </a>
          </div>
        <% } else { %>

          <!-- Key Metrics Cards (KPIs) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Travel Spend</span>
                <div class="w-10 h-10 rounded-xl bg-red-50 text-red-500 flex items-center justify-center">
                  <i class="fas fa-coins text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900">
                ₹<%= Number(metrics.totalSpend || 0).toLocaleString('en-IN') %>
              </div>
              <div class="text-xs text-gray-500 mt-2 flex items-center justify-between">
                <span>Upcoming: <strong class="text-gray-700">₹<%= Number(metrics.upcomingSpend || 0).toLocaleString('en-IN') %></strong></span>
                <span>Past: <strong class="text-gray-700">₹<%= Number(metrics.completedSpend || 0).toLocaleString('en-IN') %></strong></span>
              </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Nights Stayed</span>
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center">
                  <i class="fas fa-moon text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900">
                <%= metrics.totalNights %> <span class="text-base font-semibold text-gray-500">Nights</span>
              </div>
              <div class="text-xs text-gray-500 mt-2">
                Across <strong class="text-gray-700"><%= metrics.totalBookings %></strong> completed & confirmed trips
              </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Avg. Nightly Rate</span>
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center">
                  <i class="fas fa-tag text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900">
                ₹<%= Number(metrics.avgNightlyRate || 0).toLocaleString('en-IN') %>
                <span class="text-xs font-medium text-gray-400">/ night</span>
              </div>
              <div class="text-xs text-gray-500 mt-2">
                Avg. Trip Cost: <strong class="text-gray-700">₹<%= Number(metrics.avgTripCost || 0).toLocaleString('en-IN') %></strong>
              </div>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Top Destination</span>
                <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center">
                  <i class="fas fa-location-dot text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900 truncate">
                <%= metrics.topDestination %>
              </div>
              <div class="text-xs text-gray-500 mt-2 truncate">
                <%= cityBreakdown.length %> distinct <%= cityBreakdown.length === 1 ? 'city' : 'cities' %> explored
              </div>
            </div>
          </div>

          <!-- Interactive Travel Budget Goal Planner -->
          <div class="bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-sm mb-8">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 pb-6 border-b border-gray-100">
              <div>
                <div class="inline-flex items-center gap-1.5 text-xs font-bold text-red-500 uppercase tracking-wider mb-1">
                  <i class="fas fa-bullseye"></i> Budget Goal Planner
                </div>
                <h2 class="text-xl font-extrabold text-gray-900">Annual Travel Budget Tracker</h2>
                <p class="text-sm text-gray-500 mt-0.5">
                  Set and adjust your target travel budget to track real-time utilization.
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                <label class="text-xs font-bold text-gray-600 uppercase">Target Budget (₹):</label>
                <div class="relative w-44">
                  <span class="absolute left-3 top-2.5 text-gray-400 font-bold">₹</span>
                  <input 
                    id="targetBudgetInput" 
                    type="number" 
                    step="5000" 
                    min="10000" 
                    max="1000000" 
                    value="<%= metrics.targetBudget %>" 
                    class="w-full pl-8 pr-3 py-2 text-sm font-bold border border-gray-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:outline-none"
                  />
                </div>
                <span id="budgetStatusBadge" class="text-xs font-bold px-3 py-1.5 rounded-full transition-all">
                  Calculating...
                </span>
              </div>
            </div>

            <div class="mt-6">
              <div class="flex justify-between items-baseline mb-2">
                <div class="text-sm">
                  <span class="text-gray-500">Spent:</span>
                  <span class="font-extrabold text-gray-900 ml-1">₹<%= Number(metrics.totalSpend).toLocaleString('en-IN') %></span>
                </div>
                <div class="text-sm">
                  <span class="text-gray-500">Remaining:</span>
                  <span id="remainingBudgetDisplay" class="font-extrabold text-emerald-600 ml-1">₹0</span>
                </div>
                <div class="text-sm font-bold text-gray-700">
                  <span id="budgetPercentDisplay">0%</span> of limit
                </div>
              </div>

              <div class="w-full bg-gray-100 rounded-full h-4 overflow-hidden shadow-inner p-0.5">
                <div 
                  id="budgetProgressBar" 
                  class="h-full rounded-full transition-all duration-500 bg-red-500" 
                  style="width: 0%"
                ></div>
              </div>

              <div class="flex justify-between text-[11px] text-gray-400 font-semibold mt-2">
                <span>₹0</span>
                <span>Slide or edit budget above for instant projection</span>
                <span id="targetMaxLabel">₹<%= Number(metrics.targetBudget).toLocaleString('en-IN') %></span>
              </div>
            </div>
          </div>

          <!-- Visual Analytics: Charts Section -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
            <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
              <div class="flex justify-between items-center mb-4">
                <div>
                  <h3 class="text-lg font-extrabold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-chart-column text-red-500"></i> Monthly Spend Trend
                  </h3>
                  <p class="text-xs text-gray-400">Total accommodation cost over booking periods</p>
                </div>
                <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2.5 py-1 rounded-lg">INR (₹)</span>
              </div>
              <div class="relative w-full h-72">
                <canvas id="monthlyTrendChart"></canvas>
              </div>
            </div>

            <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
              <div class="flex justify-between items-center mb-4">
                <div>
                  <h3 class="text-lg font-extrabold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-pie-chart text-orange-500"></i> Spend by Destination
                  </h3>
                  <p class="text-xs text-gray-400">Breakdown of budget across cities</p>
                </div>
                <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2.5 py-1 rounded-lg">City Share</span>
              </div>
              <div class="relative w-full h-72 flex items-center justify-center">
                <canvas id="cityBreakdownChart"></canvas>
              </div>
            </div>
          </div>

          <!-- Detailed Trip Ledger & Table -->
          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6 md:p-8">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
              <div>
                <h3 class="text-xl font-extrabold text-gray-900 flex items-center gap-2">
                  <i class="fas fa-receipt text-red-500"></i> Travel Expense Ledger
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">Comprehensive audit trail of each individual stay</p>
              </div>

              <div class="w-full sm:w-72 relative">
                <i class="fas fa-search absolute left-3.5 top-3 text-gray-400 text-xs"></i>
                <input 
                  id="ledgerSearchInput"
                  type="text" 
                  placeholder="Filter by city or property..." 
                  class="w-full pl-9 pr-4 py-2 text-xs font-medium border border-gray-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:outline-none"
                />
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm" id="ledgerTable">
                <thead>
                  <tr class="text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 pb-3">
                    <th class="py-3 px-3">Stay & Location</th>
                    <th class="py-3 px-3">Trip Dates</th>
                    <th class="py-3 px-3">Duration</th>
                    <th class="py-3 px-3">Nightly Rate</th>
                    <th class="py-3 px-3">Total Spent</th>
                    <th class="py-3 px-3">% of Spend</th>
                    <th class="py-3 px-3">Status</th>
                    <th class="py-3 px-3 text-right">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                  <% bookings.forEach(booking => { %>
                    <tr class="ledger-row hover:bg-gray-50/80 transition duration-150">
                      <td class="py-3.5 px-3">
                        <div class="flex items-center gap-3">
                          <img 
                            src="<%= booking.home ? booking.home.photoUrl : (booking.photoUrl || '') %>" 
                            alt="Stay photo" 
                            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=200';"
                            class="w-12 h-12 rounded-xl object-cover flex-shrink-0 shadow-sm border border-gray-100"
                          />
                          <div>
                            <div class="font-bold text-gray-900 stay-name">
                              <%= booking.home ? booking.home.houseName : booking.houseName %>
                            </div>
                            <div class="text-xs text-gray-500 stay-location flex items-center gap-1">
                              <i class="fas fa-map-pin text-[10px] text-red-500"></i>
                              <%= booking.home ? booking.home.location : booking.location %>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-3 text-xs text-gray-600 whitespace-nowrap">
                        <div class="font-semibold text-gray-800"><%= booking.checkIn %></div>
                        <div class="text-gray-400">to <%= booking.checkOut %></div>
                      </td>
                      <td class="py-3.5 px-3 text-xs whitespace-nowrap">
                        <span class="font-bold text-gray-800"><%= booking.calculatedNights %> <%= booking.calculatedNights === 1 ? 'Night' : 'Nights' %></span>
                        <div class="text-gray-400"><%= booking.guestsCount %> <%= booking.guestsCount === 1 ? 'Guest' : 'Guests' %></div>
                      </td>
                      <td class="py-3.5 px-3 text-xs text-gray-600 whitespace-nowrap">
                        ₹<%= Number(booking.home ? booking.home.price : (booking.price || 0)).toLocaleString('en-IN') %>
                      </td>
                      <td class="py-3.5 px-3 whitespace-nowrap font-extrabold text-red-600">
                        ₹<%= Number(booking.totalAmount).toLocaleString('en-IN') %>
                      </td>
                      <td class="py-3.5 px-3 whitespace-nowrap">
                        <div class="flex items-center gap-2">
                          <div class="w-12 bg-gray-100 rounded-full h-2 overflow-hidden">
                            <div class="bg-red-500 h-full rounded-full spend-pct-bar" data-width="<%= booking.spendPercentage %>"></div>
                          </div>
                          <span class="text-xs font-bold text-gray-600"><%= booking.spendPercentage %>%</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-3 whitespace-nowrap">
                        <% if (booking.status === 'Completed') { %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700">
                            <i class="fas fa-check-double text-[10px]"></i> Completed
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700">
                            <i class="fas fa-check-circle text-[10px]"></i> Confirmed
                          </span>
                        <% } %>
                      </td>
                      <td class="py-3.5 px-3 text-right whitespace-nowrap">
                        <% if (booking.homeId) { %>
                          <a href="/homes/<%= booking.homeId %>" class="text-xs font-bold text-red-500 hover:text-red-700 hover:underline">
                            View Home <i class="fas fa-arrow-right text-[10px] ml-0.5"></i>
                          </a>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: HOST REVENUE & EARNINGS ANALYZER    -->
      <!-- ========================================== -->
      <% if (typeof isHost !== 'undefined' && isHost && typeof hostMetrics !== 'undefined' && hostMetrics) { %>
        <div id="revenueViewSection" class="hidden">
          <!-- Host Revenue Header Banner -->
          <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 rounded-3xl p-6 md:p-8 text-white shadow-lg mb-8 relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 opacity-10 text-white pointer-events-none">
              <i class="fa-solid fa-chart-line text-9xl"></i>
            </div>

            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
              <div>
                <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
                  <i class="fas fa-coins"></i> Host Financial Dashboard
                </div>
                <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">Host Revenue & Earnings</h1>
                <p class="text-emerald-100 text-sm md:text-base mt-1 max-w-2xl">
                  Analyze payouts from guest reservations across all your listed properties, monitor booking revenue trends, and track top-performing homes.
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-3">
                <a 
                  href="/spend-analyzer/export?type=revenue" 
                  class="bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-md px-4 py-2.5 rounded-xl text-sm font-semibold flex items-center gap-2 transition duration-200 shadow-sm"
                  title="Download Host Revenue CSV report"
                >
                  <i class="fas fa-file-csv text-base"></i> Export Revenue CSV
                </a>
                <a 
                  href="/host/add-home" 
                  class="bg-white text-emerald-700 hover:bg-gray-100 px-5 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 transition duration-200 shadow-sm"
                >
                  <i class="fas fa-plus"></i> Add New Listing
                </a>
              </div>
            </div>
          </div>

          <!-- Host Revenue KPI Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
            <!-- Total Gross Revenue -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Gross Revenue</span>
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                  <i class="fas fa-sack-dollar text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900">
                ₹<%= Number(hostMetrics.totalRevenue || 0).toLocaleString('en-IN') %>
              </div>
              <div class="text-xs text-gray-500 mt-2 flex items-center justify-between">
                <span>Earned: <strong class="text-emerald-700">₹<%= Number(hostMetrics.completedRevenue || 0).toLocaleString('en-IN') %></strong></span>
                <span>Upcoming: <strong class="text-blue-700">₹<%= Number(hostMetrics.upcomingRevenue || 0).toLocaleString('en-IN') %></strong></span>
              </div>
            </div>

            <!-- Total Reservations Received -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Bookings Received</span>
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                  <i class="fas fa-calendar-check text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900">
                <%= hostMetrics.totalBookings %> <span class="text-base font-semibold text-gray-500">Reservations</span>
              </div>
              <div class="text-xs text-gray-500 mt-2">
                Across <strong class="text-gray-700"><%= hostMetrics.totalHostedNights %></strong> total hosted nights
              </div>
            </div>

            <!-- Average Payout per Booking -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Avg. Payout / Booking</span>
                <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                  <i class="fas fa-hand-holding-dollar text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900">
                ₹<%= Number(hostMetrics.avgPayoutPerBooking || 0).toLocaleString('en-IN') %>
              </div>
              <div class="text-xs text-gray-500 mt-2">
                Avg. Nightly Yield: <strong class="text-gray-700">₹<%= Number(hostMetrics.avgNightlyRevenue || 0).toLocaleString('en-IN') %></strong>
              </div>
            </div>

            <!-- Top Earning Property -->
            <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Top Earning Listing</span>
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                  <i class="fas fa-trophy text-lg"></i>
                </div>
              </div>
              <div class="text-2xl font-extrabold text-gray-900 truncate">
                <%= hostMetrics.topProperty %>
              </div>
              <div class="text-xs text-gray-500 mt-2 truncate">
                <%= propertyBreakdown.length %> active revenue-generating <%= propertyBreakdown.length === 1 ? 'listing' : 'listings' %>
              </div>
            </div>
          </div>

          <!-- Host Revenue Visual Charts Section -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
            <!-- Monthly Revenue Trend (Bar Chart) -->
            <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
              <div class="flex justify-between items-center mb-4">
                <div>
                  <h3 class="text-lg font-extrabold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-chart-column text-emerald-600"></i> Monthly Host Payouts
                  </h3>
                  <p class="text-xs text-gray-400">Total gross revenue received per calendar month</p>
                </div>
                <span class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-lg">Revenue (₹)</span>
              </div>
              <div class="relative w-full h-72">
                <canvas id="hostMonthlyRevenueChart"></canvas>
              </div>
            </div>

            <!-- Revenue by Property (Doughnut Chart) -->
            <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
              <div class="flex justify-between items-center mb-4">
                <div>
                  <h3 class="text-lg font-extrabold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-pie-chart text-teal-600"></i> Revenue by Listing
                  </h3>
                  <p class="text-xs text-gray-400">Income contribution share per property</p>
                </div>
                <span class="text-xs font-semibold bg-teal-50 text-teal-700 px-2.5 py-1 rounded-lg">Property Share</span>
              </div>
              <div class="relative w-full h-72 flex items-center justify-center">
                <canvas id="hostPropertyRevenueChart"></canvas>
              </div>
            </div>
          </div>

          <!-- Incoming Guest Reservations Ledger Table -->
          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6 md:p-8">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
              <div>
                <h3 class="text-xl font-extrabold text-gray-900 flex items-center gap-2">
                  <i class="fas fa-receipt text-emerald-600"></i> Guest Bookings & Payout Ledger
                </h3>
                <p class="text-xs text-gray-500 mt-0.5">Audit log of all guest reservations across your listings</p>
              </div>

              <div class="w-full sm:w-72 relative">
                <i class="fas fa-search absolute left-3.5 top-3 text-gray-400 text-xs"></i>
                <input 
                  id="hostLedgerSearchInput"
                  type="text" 
                  placeholder="Filter by guest name or property..." 
                  class="w-full pl-9 pr-4 py-2 text-xs font-medium border border-gray-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                />
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm" id="hostLedgerTable">
                <thead>
                  <tr class="text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 pb-3">
                    <th class="py-3 px-3">Guest Details</th>
                    <th class="py-3 px-3">Hosted Property</th>
                    <th class="py-3 px-3">Stay Dates</th>
                    <th class="py-3 px-3">Nights & Guests</th>
                    <th class="py-3 px-3">Payout Revenue</th>
                    <th class="py-3 px-3">Status</th>
                    <th class="py-3 px-3 text-right">Booked On</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-medium">
                  <% hostBookings.forEach(hb => { %>
                    <tr class="host-ledger-row hover:bg-gray-50/80 transition duration-150">
                      <td class="py-3.5 px-3">
                        <div class="font-bold text-gray-900 guest-name"><%= hb.guestName %></div>
                        <div class="text-xs text-gray-400"><%= hb.guestEmail %></div>
                      </td>
                      <td class="py-3.5 px-3">
                        <div class="font-bold text-gray-900 property-name">
                          <%= hb.home ? hb.home.houseName : 'Property' %>
                        </div>
                        <div class="text-xs text-gray-500 flex items-center gap-1">
                          <i class="fas fa-map-pin text-[10px] text-emerald-600"></i>
                          <%= hb.home ? hb.home.location : '' %>
                        </div>
                      </td>
                      <td class="py-3.5 px-3 text-xs text-gray-600 whitespace-nowrap">
                        <div class="font-semibold text-gray-800"><%= hb.checkIn %></div>
                        <div class="text-gray-400">to <%= hb.checkOut %></div>
                      </td>
                      <td class="py-3.5 px-3 text-xs whitespace-nowrap">
                        <span class="font-bold text-gray-800"><%= hb.calculatedNights %> <%= hb.calculatedNights === 1 ? 'Night' : 'Nights' %></span>
                        <div class="text-gray-400"><%= hb.guestsCount %> <%= hb.guestsCount === 1 ? 'Guest' : 'Guests' %></div>
                      </td>
                      <td class="py-3.5 px-3 whitespace-nowrap font-extrabold text-emerald-600 text-base">
                        ₹<%= Number(hb.totalAmount).toLocaleString('en-IN') %>
                      </td>
                      <td class="py-3.5 px-3 whitespace-nowrap">
                        <% if (hb.status === 'Completed') { %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700">
                            <i class="fas fa-check-double text-[10px]"></i> Completed
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700">
                            <i class="fas fa-check-circle text-[10px]"></i> Confirmed
                          </span>
                        <% } %>
                      </td>
                      <td class="py-3.5 px-3 text-right text-xs text-gray-500 whitespace-nowrap">
                        <%= hb.bookedAt %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-16 py-6 text-center text-xs text-gray-500">
      <div class="container mx-auto px-4">
        &copy; 2026 Airbnb, Inc. All rights reserved. &bull; Spend & Revenue Analytics &bull; Privacy & Terms
      </div>
    </footer>

    <!-- Safe JSON Data Block for Client Analytics -->
    <script type="application/json" id="spendData">
      <%- JSON.stringify({
        hasBookings: Boolean(bookings && bookings.length > 0),
        totalSpend: (metrics && metrics.totalSpend) || 0,
        monthlyTrend: monthlyTrend || [],
        cityBreakdown: cityBreakdown || [],
        isHost: Boolean(typeof isHost !== 'undefined' && isHost),
        hasHostMetrics: Boolean(typeof hostMetrics !== 'undefined' && hostMetrics),
        hostMonthlyTrend: (typeof hostMonthlyTrend !== 'undefined' && hostMonthlyTrend) || [],
        propertyBreakdown: (typeof propertyBreakdown !== 'undefined' && propertyBreakdown) || [],
        totalHostRevenue: (typeof hostMetrics !== 'undefined' && hostMetrics && hostMetrics.totalRevenue) || 0
      }).replace(/</g, '\\u003c') %>
    </script>

    <!-- ========================================== -->
    <!-- CLIENT JAVASCRIPT & CHARTS INITIALIZATION -->
    <!-- ========================================== -->
    <script>
      // Tab Switching Logic (for Hosts)
      function switchTab(tab) {
        const spendSection = document.getElementById('spendViewSection');
        const revenueSection = document.getElementById('revenueViewSection');
        const tabSpendBtn = document.getElementById('tabSpendBtn');
        const tabRevenueBtn = document.getElementById('tabRevenueBtn');

        if (!spendSection || !revenueSection) return;

        if (tab === 'revenue') {
          spendSection.classList.add('hidden');
          revenueSection.classList.remove('hidden');

          if (tabSpendBtn) tabSpendBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 text-gray-600 hover:text-gray-900 cursor-pointer';
          if (tabRevenueBtn) tabRevenueBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 shadow-sm bg-white text-emerald-700 cursor-pointer';
          
          if (!window.hostChartsRendered && typeof renderHostCharts === 'function') {
            renderHostCharts();
            window.hostChartsRendered = true;
          }
        } else {
          revenueSection.classList.add('hidden');
          spendSection.classList.remove('hidden');

          if (tabSpendBtn) tabSpendBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 shadow-sm bg-white text-red-600 cursor-pointer';
          if (tabRevenueBtn) tabRevenueBtn.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition-all duration-200 text-gray-600 hover:text-gray-900 cursor-pointer';
        }
      }

      // Read JSON payload
      const analyticsEl = document.getElementById('spendData');
      const analytics = analyticsEl ? JSON.parse(analyticsEl.textContent || '{}') : {};

      // Auto-switch to revenue tab if URL has ?tab=revenue or #revenue
      document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('tab') === 'revenue' || window.location.hash === '#revenue') {
          switchTab('revenue');
        }
        document.querySelectorAll('.spend-pct-bar').forEach(function(el) {
          el.style.width = (el.getAttribute('data-width') || 0) + '%';
        });
      });

      // 1. Spend Analyzer Budget Tracker & Charts
      if (analytics.hasBookings) {
        const totalSpend = analytics.totalSpend || 0;
        const monthlyData = analytics.monthlyTrend || [];
        const cityData = analytics.cityBreakdown || [];

        const budgetInput = document.getElementById('targetBudgetInput');
        const progressBar = document.getElementById('budgetProgressBar');
        const percentDisplay = document.getElementById('budgetPercentDisplay');
        const remainingDisplay = document.getElementById('remainingBudgetDisplay');
        const statusBadge = document.getElementById('budgetStatusBadge');
        const targetMaxLabel = document.getElementById('targetMaxLabel');

        function updateBudgetTracker() {
          if (!budgetInput || !progressBar) return;
          const budget = parseFloat(budgetInput.value) || 1;
          const ratio = (totalSpend / budget) * 100;
          const cappedWidth = Math.min(100, Math.max(0, ratio));
          const remaining = budget - totalSpend;

          progressBar.style.width = cappedWidth + '%';
          if (percentDisplay) percentDisplay.textContent = Math.round(ratio) + '%';
          if (targetMaxLabel) targetMaxLabel.textContent = '₹' + Number(budget).toLocaleString('en-IN');

          if (remainingDisplay) {
            if (remaining >= 0) {
              remainingDisplay.textContent = '₹' + Number(remaining).toLocaleString('en-IN');
              remainingDisplay.className = 'font-extrabold text-emerald-600 ml-1';
            } else {
              remainingDisplay.textContent = '-₹' + Number(Math.abs(remaining)).toLocaleString('en-IN') + ' (Over)';
              remainingDisplay.className = 'font-extrabold text-red-600 ml-1';
            }
          }

          if (statusBadge) {
            if (ratio <= 75) {
              progressBar.className = 'h-full rounded-full transition-all duration-500 bg-emerald-500';
              statusBadge.className = 'text-xs font-bold px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200';
              statusBadge.innerHTML = '<i class="fas fa-shield-halved mr-1"></i> Under Budget (Safe)';
            } else if (ratio <= 95) {
              progressBar.className = 'h-full rounded-full transition-all duration-500 bg-amber-500';
              statusBadge.className = 'text-xs font-bold px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200';
              statusBadge.innerHTML = '<i class="fas fa-triangle-exclamation mr-1"></i> Nearing Limit (' + Math.round(ratio) + '%)';
            } else {
              progressBar.className = 'h-full rounded-full transition-all duration-500 bg-red-600';
              statusBadge.className = 'text-xs font-bold px-3 py-1.5 rounded-full bg-red-50 text-red-700 border border-red-200';
              statusBadge.innerHTML = '<i class="fas fa-circle-exclamation mr-1"></i> Budget Exceeded';
            }
          }
        }

        if (budgetInput) {
          budgetInput.addEventListener('input', updateBudgetTracker);
          updateBudgetTracker();
        }

        // Monthly Spend Chart
        const monthlyCtx = document.getElementById('monthlyTrendChart');
        if (monthlyCtx) {
          new Chart(monthlyCtx, {
            type: 'bar',
            data: {
              labels: monthlyData.map(m => m.month),
              datasets: [{
                label: 'Monthly Spend (₹)',
                data: monthlyData.map(m => m.totalAmount),
                backgroundColor: 'rgba(255, 56, 92, 0.85)',
                hoverBackgroundColor: 'rgba(224, 0, 68, 1)',
                borderRadius: 8,
                barPercentage: 0.55
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#1f2937',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: (ctx) => ' Spent: ₹' + Number(ctx.raw).toLocaleString('en-IN')
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  grid: { color: '#f3f4f6' },
                  ticks: {
                    font: { size: 11 },
                    callback: (v) => '₹' + Number(v).toLocaleString('en-IN')
                  }
                },
                x: {
                  grid: { display: false },
                  ticks: { font: { size: 11, weight: 'bold' } }
                }
              }
            }
          });
        }

        // Destination Spend Chart
        const cityCtx = document.getElementById('cityBreakdownChart');
        if (cityCtx) {
          const colors = ['#FF385C', '#00A699', '#FC642D', '#484848', '#8B5CF6', '#3B82F6', '#10B981'];
          new Chart(cityCtx, {
            type: 'doughnut',
            data: {
              labels: cityData.map(c => c.city),
              datasets: [{
                data: cityData.map(c => c.totalAmount),
                backgroundColor: colors.slice(0, cityData.length),
                borderWidth: 2,
                borderColor: '#ffffff',
                hoverOffset: 6
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: { padding: 14, boxWidth: 12, font: { size: 12, weight: '600' } }
                },
                tooltip: {
                  backgroundColor: '#1f2937',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: (ctx) => {
                      const pct = Math.round((ctx.raw / totalSpend) * 100);
                      return ' ' + ctx.label + ': ₹' + Number(ctx.raw).toLocaleString('en-IN') + ' (' + pct + '%)';
                    }
                  }
                }
              },
              cutout: '68%'
            }
          });
        }

        // Ledger Search
        const searchInput = document.getElementById('ledgerSearchInput');
        if (searchInput) {
          searchInput.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            document.querySelectorAll('.ledger-row').forEach(row => {
              const name = row.querySelector('.stay-name')?.textContent.toLowerCase() || '';
              const loc = row.querySelector('.stay-location')?.textContent.toLowerCase() || '';
              row.style.display = (name.includes(query) || loc.includes(query)) ? '' : 'none';
            });
          });
        }
      }

      // 2. Host Revenue Charts Function
      let renderHostCharts = null;
      if (analytics.isHost && analytics.hasHostMetrics) {
        const hostMonthlyData = analytics.hostMonthlyTrend || [];
        const hostPropertyData = analytics.propertyBreakdown || [];
        const totalHostRevenue = analytics.totalHostRevenue || 0;

        renderHostCharts = function() {
          // 1. Host Monthly Revenue Chart
          const hostMonthCtx = document.getElementById('hostMonthlyRevenueChart');
          if (hostMonthCtx) {
            new Chart(hostMonthCtx, {
              type: 'bar',
              data: {
                labels: hostMonthlyData.map(m => m.month),
                datasets: [{
                  label: 'Gross Payout (₹)',
                  data: hostMonthlyData.map(m => m.totalRevenue),
                  backgroundColor: 'rgba(16, 185, 129, 0.85)',
                  hoverBackgroundColor: 'rgba(5, 150, 105, 1)',
                  borderRadius: 8,
                  barPercentage: 0.55
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                  legend: { display: false },
                  tooltip: {
                    backgroundColor: '#1f2937',
                    padding: 10,
                    cornerRadius: 8,
                    callbacks: {
                      label: (ctx) => ' Earned: ₹' + Number(ctx.raw).toLocaleString('en-IN')
                    }
                  }
                },
                scales: {
                  y: {
                    beginAtZero: true,
                    grid: { color: '#f3f4f6' },
                    ticks: {
                      font: { size: 11 },
                      callback: (v) => '₹' + Number(v).toLocaleString('en-IN')
                    }
                  },
                  x: {
                    grid: { display: false },
                    ticks: { font: { size: 11, weight: 'bold' } }
                  }
                }
              }
            });
          }

          // 2. Host Property Revenue Chart
          const hostPropCtx = document.getElementById('hostPropertyRevenueChart');
          if (hostPropCtx) {
            const emeraldPalette = ['#10B981', '#06B6D4', '#3B82F6', '#8B5CF6', '#F59E0B', '#EC4899', '#6366F1'];
            new Chart(hostPropCtx, {
              type: 'doughnut',
              data: {
                labels: hostPropertyData.map(p => p.propertyName),
                datasets: [{
                  data: hostPropertyData.map(p => p.totalRevenue),
                  backgroundColor: emeraldPalette.slice(0, hostPropertyData.length),
                  borderWidth: 2,
                  borderColor: '#ffffff',
                  hoverOffset: 6
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                  legend: {
                    position: 'bottom',
                    labels: { padding: 14, boxWidth: 12, font: { size: 12, weight: '600' } }
                  },
                  tooltip: {
                    backgroundColor: '#1f2937',
                    padding: 10,
                    cornerRadius: 8,
                    callbacks: {
                      label: (ctx) => {
                        const pct = Math.round((ctx.raw / totalHostRevenue) * 100);
                        return ' ' + ctx.label + ': ₹' + Number(ctx.raw).toLocaleString('en-IN') + ' (' + pct + '%)';
                      }
                    }
                  }
                },
                cutout: '68%'
              }
            });
          }

          // Host Ledger Filter
          const hostSearchInput = document.getElementById('hostLedgerSearchInput');
          if (hostSearchInput) {
            hostSearchInput.addEventListener('input', function(e) {
              const query = e.target.value.toLowerCase().trim();
              document.querySelectorAll('.host-ledger-row').forEach(row => {
                const guest = row.querySelector('.guest-name')?.textContent.toLowerCase() || '';
                const prop = row.querySelector('.property-name')?.textContent.toLowerCase() || '';
                row.style.display = (guest.includes(query) || prop.includes(query)) ? '' : 'none';
              });
            });
          }
        };
      }
    </script>
  </body>
</html>
