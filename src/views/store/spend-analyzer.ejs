<%- include('../partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-7xl flex-grow">
      <!-- Header Banner -->
      <div class="bg-gradient-to-r from-red-600 via-rose-500 to-orange-500 rounded-3xl p-6 md:p-8 text-white shadow-lg mb-8 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-10 text-white pointer-events-none">
          <i class="fa-solid fa-chart-pie text-9xl"></i>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
          <div>
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-2">
              <i class="fas fa-wallet"></i> Personal Travel Finance
            </div>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">Travel Spend Analyzer</h1>
            <p class="text-red-100 text-sm md:text-base mt-1 max-w-2xl">
              Track your accommodation expenditures, monitor destination budgets, and optimize your travel costs across all bookings.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <% if (bookings && bookings.length > 0) { %>
              <a 
                href="/spend-analyzer/export" 
                class="bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-md px-4 py-2.5 rounded-xl text-sm font-semibold flex items-center gap-2 transition duration-200 shadow-sm"
                title="Download CSV report"
              >
                <i class="fas fa-file-csv text-base"></i> Export CSV
              </a>
            <% } %>
            <a 
              href="/homes" 
              class="bg-white text-red-600 hover:bg-gray-100 px-5 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 transition duration-200 shadow-sm"
            >
              <i class="fas fa-compass"></i> Explore Stays
            </a>
          </div>
        </div>
      </div>

      <% if (!bookings || bookings.length === 0) { %>
        <!-- Empty State -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-12 text-center max-w-xl mx-auto my-12">
          <div class="w-20 h-20 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center mx-auto mb-5 text-3xl shadow-inner">
            <i class="fas fa-chart-line"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-2">No Travel Spending Yet</h2>
          <p class="text-gray-500 mb-6 text-sm leading-relaxed">
            Your spend analytics, destination cost breakdowns, and budget tracking will automatically appear here once you reserve your first stay.
          </p>
          <a href="/homes" class="inline-flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition duration-200">
            <i class="fas fa-search"></i> Book Your First Stay
          </a>
        </div>
      <% } else { %>

        <!-- Key Metrics Cards (KPIs) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
          <!-- Total Spend -->
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Travel Spend</span>
              <div class="w-10 h-10 rounded-xl bg-red-50 text-red-500 flex items-center justify-center">
                <i class="fas fa-coins text-lg"></i>
              </div>
            </div>
            <div class="text-2xl font-extrabold text-gray-900">
              ₹<%= Number(metrics.totalSpend || 0).toLocaleString('en-IN') %>
            </div>
            <div class="text-xs text-gray-500 mt-2 flex items-center justify-between">
              <span>Upcoming: <strong class="text-gray-700">₹<%= Number(metrics.upcomingSpend || 0).toLocaleString('en-IN') %></strong></span>
              <span>Past: <strong class="text-gray-700">₹<%= Number(metrics.completedSpend || 0).toLocaleString('en-IN') %></strong></span>
            </div>
          </div>

          <!-- Total Nights & Trips -->
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Total Nights Stayed</span>
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center">
                <i class="fas fa-moon text-lg"></i>
              </div>
            </div>
            <div class="text-2xl font-extrabold text-gray-900">
              <%= metrics.totalNights %> <span class="text-base font-semibold text-gray-500">Nights</span>
            </div>
            <div class="text-xs text-gray-500 mt-2">
              Across <strong class="text-gray-700"><%= metrics.totalBookings %></strong> completed & confirmed trips
            </div>
          </div>

          <!-- Average Nightly Cost -->
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Avg. Nightly Rate</span>
              <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center">
                <i class="fas fa-tag text-lg"></i>
              </div>
            </div>
            <div class="text-2xl font-extrabold text-gray-900">
              ₹<%= Number(metrics.avgNightlyRate || 0).toLocaleString('en-IN') %>
              <span class="text-xs font-medium text-gray-400">/ night</span>
            </div>
            <div class="text-xs text-gray-500 mt-2">
              Avg. Trip Cost: <strong class="text-gray-700">₹<%= Number(metrics.avgTripCost || 0).toLocaleString('en-IN') %></strong>
            </div>
          </div>

          <!-- Top Destination -->
          <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Top Destination</span>
              <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-500 flex items-center justify-center">
                <i class="fas fa-location-dot text-lg"></i>
              </div>
            </div>
            <div class="text-2xl font-extrabold text-gray-900 truncate">
              <%= metrics.topDestination %>
            </div>
            <div class="text-xs text-gray-500 mt-2 truncate">
              <%= cityBreakdown.length %> distinct <%= cityBreakdown.length === 1 ? 'city' : 'cities' %> explored so far
            </div>
          </div>
        </div>

        <!-- Interactive Travel Budget Goal Planner -->
        <div class="bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-sm mb-8">
          <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 pb-6 border-b border-gray-100">
            <div>
              <div class="inline-flex items-center gap-1.5 text-xs font-bold text-red-500 uppercase tracking-wider mb-1">
                <i class="fas fa-bullseye"></i> Budget Goal Planner
              </div>
              <h2 class="text-xl font-extrabold text-gray-900">Annual Travel Budget Tracker</h2>
              <p class="text-sm text-gray-500 mt-0.5">
                Set and adjust your target travel budget to track real-time utilization.
              </p>
            </div>

            <!-- Budget Input & Adjustment -->
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
              <label class="text-xs font-bold text-gray-600 uppercase">Target Budget (₹):</label>
              <div class="relative w-44">
                <span class="absolute left-3 top-2.5 text-gray-400 font-bold">₹</span>
                <input 
                  id="targetBudgetInput" 
                  type="number" 
                  step="5000" 
                  min="10000" 
                  max="1000000" 
                  value="<%= metrics.targetBudget %>" 
                  class="w-full pl-8 pr-3 py-2 text-sm font-bold border border-gray-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:outline-none"
                />
              </div>
              <span id="budgetStatusBadge" class="text-xs font-bold px-3 py-1.5 rounded-full transition-all">
                Calculating...
              </span>
            </div>
          </div>

          <!-- Progress Bar & Analytics -->
          <div class="mt-6">
            <div class="flex justify-between items-baseline mb-2">
              <div class="text-sm">
                <span class="text-gray-500">Spent:</span>
                <span class="font-extrabold text-gray-900 ml-1">₹<%= Number(metrics.totalSpend).toLocaleString('en-IN') %></span>
              </div>
              <div class="text-sm">
                <span class="text-gray-500">Remaining:</span>
                <span id="remainingBudgetDisplay" class="font-extrabold text-emerald-600 ml-1">₹0</span>
              </div>
              <div class="text-sm font-bold text-gray-700">
                <span id="budgetPercentDisplay">0%</span> of limit
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-gray-100 rounded-full h-4 overflow-hidden shadow-inner p-0.5">
              <div 
                id="budgetProgressBar" 
                class="h-full rounded-full transition-all duration-500 bg-red-500" 
                style="width: 0%"
              ></div>
            </div>

            <div class="flex justify-between text-[11px] text-gray-400 font-semibold mt-2">
              <span>₹0</span>
              <span>Slide or edit budget above for instant projection</span>
              <span id="targetMaxLabel">₹<%= Number(metrics.targetBudget).toLocaleString('en-IN') %></span>
            </div>
          </div>
        </div>

        <!-- Visual Analytics: Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
          <!-- Monthly Spending Trend (Bar Chart) -->
          <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
            <div class="flex justify-between items-center mb-4">
              <div>
                <h3 class="text-lg font-extrabold text-gray-900 flex items-center gap-2">
                  <i class="fas fa-chart-column text-red-500"></i> Monthly Spend Trend
                </h3>
                <p class="text-xs text-gray-400">Total accommodation cost over booking periods</p>
              </div>
              <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2.5 py-1 rounded-lg">
                INR (₹)
              </span>
            </div>

            <div class="relative w-full h-72">
              <canvas id="monthlyTrendChart"></canvas>
            </div>
          </div>

          <!-- Destination Breakdown (Doughnut Chart) -->
          <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
            <div class="flex justify-between items-center mb-4">
              <div>
                <h3 class="text-lg font-extrabold text-gray-900 flex items-center gap-2">
                  <i class="fas fa-pie-chart text-orange-500"></i> Spend by Destination
                </h3>
                <p class="text-xs text-gray-400">Breakdown of budget across cities</p>
              </div>
              <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2.5 py-1 rounded-lg">
                City Share
              </span>
            </div>

            <div class="relative w-full h-72 flex items-center justify-center">
              <canvas id="cityBreakdownChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Detailed Trip Ledger & Table -->
        <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6 md:p-8">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
            <div>
              <h3 class="text-xl font-extrabold text-gray-900 flex items-center gap-2">
                <i class="fas fa-receipt text-red-500"></i> Travel Expense Ledger
              </h3>
              <p class="text-xs text-gray-500 mt-0.5">Comprehensive audit trail of each individual stay</p>
            </div>

            <!-- Instant Search Filter -->
            <div class="w-full sm:w-72 relative">
              <i class="fas fa-search absolute left-3.5 top-3 text-gray-400 text-xs"></i>
              <input 
                id="ledgerSearchInput"
                type="text" 
                placeholder="Filter by city or property..." 
                class="w-full pl-9 pr-4 py-2 text-xs font-medium border border-gray-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm" id="ledgerTable">
              <thead>
                <tr class="text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 pb-3">
                  <th class="py-3 px-3">Stay & Location</th>
                  <th class="py-3 px-3">Trip Dates</th>
                  <th class="py-3 px-3">Duration</th>
                  <th class="py-3 px-3">Nightly Rate</th>
                  <th class="py-3 px-3">Total Spent</th>
                  <th class="py-3 px-3">% of Spend</th>
                  <th class="py-3 px-3">Status</th>
                  <th class="py-3 px-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 font-medium">
                <% bookings.forEach(booking => { %>
                  <tr class="ledger-row hover:bg-gray-50/80 transition duration-150">
                    <!-- Property Name & Location -->
                    <td class="py-3.5 px-3">
                      <div class="flex items-center gap-3">
                        <img 
                          src="<%= booking.home ? booking.home.photoUrl : (booking.photoUrl || '') %>" 
                          alt="Stay photo" 
                          onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=200';"
                          class="w-12 h-12 rounded-xl object-cover flex-shrink-0 shadow-sm border border-gray-100"
                        />
                        <div>
                          <div class="font-bold text-gray-900 stay-name">
                            <%= booking.home ? booking.home.houseName : booking.houseName %>
                          </div>
                          <div class="text-xs text-gray-500 stay-location flex items-center gap-1">
                            <i class="fas fa-map-pin text-[10px] text-red-500"></i>
                            <%= booking.home ? booking.home.location : booking.location %>
                          </div>
                        </div>
                      </div>
                    </td>

                    <!-- Dates -->
                    <td class="py-3.5 px-3 text-xs text-gray-600 whitespace-nowrap">
                      <div class="font-semibold text-gray-800"><%= booking.checkIn %></div>
                      <div class="text-gray-400">to <%= booking.checkOut %></div>
                    </td>

                    <!-- Duration & Guests -->
                    <td class="py-3.5 px-3 text-xs whitespace-nowrap">
                      <span class="font-bold text-gray-800"><%= booking.calculatedNights %> <%= booking.calculatedNights === 1 ? 'Night' : 'Nights' %></span>
                      <div class="text-gray-400"><%= booking.guestsCount %> <%= booking.guestsCount === 1 ? 'Guest' : 'Guests' %></div>
                    </td>

                    <!-- Nightly Rate -->
                    <td class="py-3.5 px-3 text-xs text-gray-600 whitespace-nowrap">
                      ₹<%= Number(booking.home ? booking.home.price : (booking.price || 0)).toLocaleString('en-IN') %>
                    </td>

                    <!-- Total Spent -->
                    <td class="py-3.5 px-3 whitespace-nowrap font-extrabold text-red-600">
                      ₹<%= Number(booking.totalAmount).toLocaleString('en-IN') %>
                    </td>

                    <!-- % of Spend -->
                    <td class="py-3.5 px-3 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <div class="w-12 bg-gray-100 rounded-full h-2 overflow-hidden">
                          <div class="bg-red-500 h-full rounded-full" style="width: <%= booking.spendPercentage %>%"></div>
                        </div>
                        <span class="text-xs font-bold text-gray-600"><%= booking.spendPercentage %>%</span>
                      </div>
                    </td>

                    <!-- Status -->
                    <td class="py-3.5 px-3 whitespace-nowrap">
                      <% if (booking.status === 'Completed') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700">
                          <i class="fas fa-check-double text-[10px]"></i> Completed
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700">
                          <i class="fas fa-check-circle text-[10px]"></i> Confirmed
                        </span>
                      <% } %>
                    </td>

                    <!-- Action Link -->
                    <td class="py-3.5 px-3 text-right whitespace-nowrap">
                      <% if (booking.homeId) { %>
                        <a 
                          href="/homes/<%= booking.homeId %>" 
                          class="text-xs font-bold text-red-500 hover:text-red-700 hover:underline"
                        >
                          View Home <i class="fas fa-arrow-right text-[10px] ml-0.5"></i>
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-16 py-6 text-center text-xs text-gray-500">
      <div class="container mx-auto px-4">
        &copy; 2026 Airbnb, Inc. All rights reserved. &bull; Spend Analyzer &bull; Privacy & Terms
      </div>
    </footer>

    <% if (bookings && bookings.length > 0) { %>
      <script>
        // Data injected safely from backend
        const totalSpend = <%= metrics.totalSpend || 0 %>;
        const monthlyData = <%- JSON.stringify(monthlyTrend || []) %>;
        const cityData = <%- JSON.stringify(cityBreakdown || []) %>;

        // 1. Budget Planner Realtime Calculation
        const budgetInput = document.getElementById('targetBudgetInput');
        const progressBar = document.getElementById('budgetProgressBar');
        const percentDisplay = document.getElementById('budgetPercentDisplay');
        const remainingDisplay = document.getElementById('remainingBudgetDisplay');
        const statusBadge = document.getElementById('budgetStatusBadge');
        const targetMaxLabel = document.getElementById('targetMaxLabel');

        function updateBudgetTracker() {
          const budget = parseFloat(budgetInput.value) || 1;
          const ratio = (totalSpend / budget) * 100;
          const cappedWidth = Math.min(100, Math.max(0, ratio));
          const remaining = budget - totalSpend;

          progressBar.style.width = cappedWidth + '%';
          percentDisplay.textContent = Math.round(ratio) + '%';
          targetMaxLabel.textContent = '₹' + Number(budget).toLocaleString('en-IN');

          if (remaining >= 0) {
            remainingDisplay.textContent = '₹' + Number(remaining).toLocaleString('en-IN');
            remainingDisplay.className = 'font-extrabold text-emerald-600 ml-1';
          } else {
            remainingDisplay.textContent = '-₹' + Number(Math.abs(remaining)).toLocaleString('en-IN') + ' (Over)';
            remainingDisplay.className = 'font-extrabold text-red-600 ml-1';
          }

          if (ratio <= 75) {
            progressBar.className = 'h-full rounded-full transition-all duration-500 bg-emerald-500';
            statusBadge.className = 'text-xs font-bold px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200';
            statusBadge.innerHTML = '<i class="fas fa-shield-halved mr-1"></i> Under Budget (Safe)';
          } else if (ratio <= 95) {
            progressBar.className = 'h-full rounded-full transition-all duration-500 bg-amber-500';
            statusBadge.className = 'text-xs font-bold px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200';
            statusBadge.innerHTML = '<i class="fas fa-triangle-exclamation mr-1"></i> Nearing Limit (' + Math.round(ratio) + '%)';
          } else {
            progressBar.className = 'h-full rounded-full transition-all duration-500 bg-red-600';
            statusBadge.className = 'text-xs font-bold px-3 py-1.5 rounded-full bg-red-50 text-red-700 border border-red-200';
            statusBadge.innerHTML = '<i class="fas fa-circle-exclamation mr-1"></i> Budget Exceeded';
          }
        }

        budgetInput.addEventListener('input', updateBudgetTracker);
        updateBudgetTracker();

        // 2. Monthly Trend Chart
        const monthlyCtx = document.getElementById('monthlyTrendChart');
        if (monthlyCtx) {
          const labels = monthlyData.map(m => m.month);
          const amounts = monthlyData.map(m => m.totalAmount);

          new Chart(monthlyCtx, {
            type: 'bar',
            data: {
              labels: labels,
              datasets: [{
                label: 'Monthly Spend (₹)',
                data: amounts,
                backgroundColor: 'rgba(255, 56, 92, 0.85)',
                hoverBackgroundColor: 'rgba(224, 0, 68, 1)',
                borderRadius: 8,
                borderSkipped: false,
                barPercentage: 0.55
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#1f2937',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: function(context) {
                      return ' Spent: ₹' + Number(context.raw).toLocaleString('en-IN');
                    }
                  }
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  grid: { color: '#f3f4f6' },
                  ticks: {
                    font: { size: 11 },
                    callback: function(value) {
                      return '₹' + Number(value).toLocaleString('en-IN');
                    }
                  }
                },
                x: {
                  grid: { display: false },
                  ticks: { font: { size: 11, weight: 'bold' } }
                }
              }
            }
          });
        }

        // 3. Destination Doughnut Chart
        const cityCtx = document.getElementById('cityBreakdownChart');
        if (cityCtx) {
          const cityLabels = cityData.map(c => c.city);
          const cityAmounts = cityData.map(c => c.totalAmount);
          const vibrantPalette = [
            '#FF385C', // Airbnb Coral
            '#00A699', // Teal
            '#FC642D', // Orange
            '#484848', // Charcoal
            '#8B5CF6', // Purple
            '#3B82F6', // Blue
            '#10B981'  // Green
          ];

          new Chart(cityCtx, {
            type: 'doughnut',
            data: {
              labels: cityLabels,
              datasets: [{
                data: cityAmounts,
                backgroundColor: vibrantPalette.slice(0, cityLabels.length),
                borderWidth: 2,
                borderColor: '#ffffff',
                hoverOffset: 6
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    padding: 14,
                    boxWidth: 12,
                    font: { size: 12, weight: '600' }
                  }
                },
                tooltip: {
                  backgroundColor: '#1f2937',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: function(context) {
                      const val = context.raw;
                      const pct = Math.round((val / totalSpend) * 100);
                      return ' ' + context.label + ': ₹' + Number(val).toLocaleString('en-IN') + ' (' + pct + '%)';
                    }
                  }
                }
              },
              cutout: '68%'
            }
          });
        }

        // 4. Client-side Table Filter
        const searchInput = document.getElementById('ledgerSearchInput');
        if (searchInput) {
          searchInput.addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('.ledger-row');

            rows.forEach(row => {
              const name = row.querySelector('.stay-name')?.textContent.toLowerCase() || '';
              const location = row.querySelector('.stay-location')?.textContent.toLowerCase() || '';

              if (name.includes(query) || location.includes(query)) {
                row.style.display = '';
              } else {
                row.style.display = 'none';
              }
            });
          });
        }
      </script>
    <% } %>
  </body>
</html>
