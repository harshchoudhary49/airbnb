<%- include('../partials/head') %>
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

      <main class="container mx-auto px-4 py-8 max-w-5xl">
        <!-- Breadcrumb / Back button -->
        <div class="mb-6">
          <a href="/homes"
            class="inline-flex items-center text-sm font-semibold text-gray-600 hover:text-red-500 transition">
            <i class="fas fa-arrow-left mr-2"></i> Back to all listings
          </a>
        </div>

        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
          <!-- Main Image -->
          <div class="relative h-96 w-full bg-gray-200">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=800';"
              class="w-full h-full object-cover" />
            <div class="absolute top-4 right-4 flex gap-2">
              <form action="<%= isFavorite ? '/favorites/remove' : '/favorites/add' %>" method="POST">
                <input type="hidden" name="homeId" value="<%= home.id %>" />
                <button type="submit"
                  class="bg-white/95 hover:bg-white text-gray-700 px-4 py-2 rounded-full shadow-md font-semibold text-sm flex items-center gap-2 transition">
                  <i class="fas fa-heart <%= isFavorite ? 'text-red-500' : 'text-gray-400' %>"></i>
                  <%= isFavorite ? 'Saved to Favorites' : 'Save to Favorites' %>
                </button>
              </form>
            </div>
          </div>

          <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <!-- Left 2 Cols: Details -->
              <div class="md:col-span-2 space-y-6">
                <div>
                  <div class="flex items-center gap-2 text-sm font-semibold text-red-500 uppercase tracking-wider mb-1">
                    <i class="fas fa-shield-alt"></i> Verified Airbnb Stay
                  </div>
                  <h1 class="text-3xl font-extrabold text-gray-900 mb-2">
                    <%= home.houseName %>
                  </h1>
                  <div class="flex flex-wrap items-center gap-4 text-gray-600 text-sm">
                    <span><i class="fas fa-map-marker-alt text-red-500 mr-1"></i>
                      <%= home.location %>
                    </span>
                    <span>&middot;</span>
                    <span class="flex items-center font-bold text-gray-800">
                      <i class="fas fa-star text-yellow-400 mr-1"></i>
                      <%= (home.rating && home.rating !=='New' ) ? home.rating + ' (Guest Favorite)' : 'New Listing' %>
                    </span>
                  </div>
                </div>

                <hr class="border-gray-200" />

                <div>
                  <h2 class="text-xl font-bold text-gray-800 mb-3">About this space</h2>
                  <p class="text-gray-600 leading-relaxed text-base">
                    <%= home.description
                      || 'Welcome to this beautiful getaway. Designed for peace, relaxation, and memorable memories. Fully furnished with modern interiors, comfortable living quarters, and top amenities.'
                      %>
                  </p>
                </div>

                <hr class="border-gray-200" />

                <div>
                  <h2 class="text-xl font-bold text-gray-800 mb-4">What this place offers</h2>
                  <div class="grid grid-cols-2 gap-4 text-gray-700 text-sm">
                    <div class="flex items-center gap-3">
                      <i class="fas fa-wifi text-lg text-gray-500 w-6"></i>
                      <span>Fast Wi-Fi (50+ Mbps)</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <i class="fas fa-car text-lg text-gray-500 w-6"></i>
                      <span>Free parking on premises</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <i class="fas fa-snowflake text-lg text-gray-500 w-6"></i>
                      <span>Air conditioning & heating</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <i class="fas fa-utensils text-lg text-gray-500 w-6"></i>
                      <span>Dedicated kitchen & cooking basics</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <i class="fas fa-tv text-lg text-gray-500 w-6"></i>
                      <span>4K Smart TV with Netflix</span>
                    </div>
                    <div class="flex items-center gap-3">
                      <i class="fas fa-shield-virus text-lg text-gray-500 w-6"></i>
                      <span>Smoke alarm & first aid kit</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right 1 Col: Booking Card -->
              <div class="md:col-span-1">
                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 shadow-sm sticky top-24">
                  <div class="flex justify-between items-baseline mb-4">
                    <div>
                      <span class="text-2xl font-extrabold text-red-500">₹<%= Number(home.price ||
                          0).toLocaleString('en-IN') %></span>
                      <span class="text-gray-500 text-sm">/ night</span>
                    </div>
                    <div class="flex items-center text-sm font-semibold text-gray-700">
                      <i class="fas fa-star text-yellow-400 mr-1"></i>
                      <%= (typeof reviewStats !=='undefined' && reviewStats.total> 0) ? reviewStats.avg : ((home.rating
                        && home.rating !== 'New') ? home.rating : 'New') %>
                        <% if (typeof reviewStats !=='undefined' && reviewStats.total> 0) { %>
                          <span class="text-xs text-gray-500 ml-1">(<%= reviewStats.total %>)</span>
                          <% } %>
                    </div>
                  </div>

                  <div class="space-y-3 mb-6 text-sm text-gray-600 bg-white p-4 rounded-xl border border-gray-200">
                    <div class="flex justify-between">
                      <span>Cleaning Fee</span>
                      <span class="font-medium text-gray-800">Included</span>
                    </div>
                    <div class="flex justify-between">
                      <span>Airbnb Service Fee</span>
                      <span class="font-medium text-gray-800">₹0</span>
                    </div>
                    <div class="flex justify-between border-t border-gray-200 pt-2 font-bold text-gray-900">
                      <span>Base Nightly Rate</span>
                      <span class="text-red-500">₹<%= Number(home.price || 0).toLocaleString('en-IN') %></span>
                    </div>
                  </div>

                  <a href="/reserve/<%= home.id %>"
                    class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3.5 px-4 rounded-xl text-center block shadow transition duration-200 text-base">
                    Reserve this Home
                  </a>

                  <p class="text-xs text-gray-400 text-center mt-3">You won't be charged yet</p>
                </div>
              </div>
            </div>

            <!-- ============================================== -->
            <!-- DYNAMIC REVIEWS & STAR RATINGS SYSTEM          -->
            <!-- ============================================== -->
            <hr class="border-gray-200 my-10" />

            <section id="reviews-section" class="scroll-mt-28">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                  <div class="flex items-center gap-3">
                    <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 flex items-center gap-2">
                      <i class="fas fa-star text-amber-400 text-2xl"></i>
                      <% if (typeof reviewStats !=='undefined' && reviewStats.total> 0) { %>
                        <span>
                          <%= reviewStats.avg %>
                        </span>
                        <span class="text-gray-400 font-normal">&middot;</span>
                        <span class="text-gray-800">
                          <%= reviewStats.total %>
                            <%= reviewStats.total===1 ? 'Review' : 'Reviews' %>
                        </span>
                        <% } else { %>
                          <span>New Listing</span>
                          <span class="text-sm font-normal text-gray-500 ml-2">No reviews yet</span>
                          <% } %>
                    </h2>
                  </div>
                  <p class="text-sm text-gray-500 mt-1">Real ratings and verified feedback from past guests</p>
                </div>

                <% if (typeof reviewStats !=='undefined' && reviewStats.total> 0 && Number(reviewStats.avg) >= 4.5) { %>
                  <div
                    class="inline-flex items-center gap-2 bg-amber-50 text-amber-800 border border-amber-200 px-4 py-2 rounded-2xl text-xs font-bold uppercase tracking-wider shadow-sm">
                    <i class="fas fa-award text-amber-500 text-base"></i> Guest Favorite
                  </div>
                  <% } %>
              </div>

              <% if (typeof reviewStats !=='undefined' && reviewStats.total> 0) { %>
                <!-- Rating Histogram & Breakdown -->
                <div
                  class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10 bg-gray-50 p-6 rounded-2xl border border-gray-100">
                  <!-- Overall Score Card -->
                  <div
                    class="flex flex-col justify-center items-center md:border-r border-gray-200 pr-0 md:pr-6 text-center">
                    <div class="text-5xl font-black text-gray-900 mb-1">
                      <%= reviewStats.avg %>
                    </div>
                    <div class="flex text-amber-400 text-lg mb-2">
                      <% const roundAvg=Math.round(Number(reviewStats.avg) || 5); %>
                        <% for (let i=1; i <=5; i++) { %>
                          <i class="fas fa-star <%= i <= roundAvg ? 'text-amber-400' : 'text-gray-300' %>"></i>
                          <% } %>
                    </div>
                    <p class="text-sm font-medium text-gray-600">Overall guest satisfaction rating</p>
                  </div>

                  <!-- Star Rating Distribution Bars -->
                  <div class="space-y-2.5 flex flex-col justify-center">
                    <% for (let star=5; star>= 1; star--) { %>
                      <div class="flex items-center gap-3 text-xs font-semibold text-gray-600">
                        <span class="w-12 text-right">
                          <%= star %>
                            <%= star===1 ? 'star' : 'stars' %>
                        </span>
                        <div class="flex-grow bg-gray-200 h-2.5 rounded-full overflow-hidden">
                          <div class="bg-amber-400 h-full rounded-full transition-all duration-500"
                            style="width: <%= reviewStats.percentages[star] %>%"></div>
                        </div>
                        <span class="w-10 text-left text-gray-500">
                          <%= reviewStats.counts[star] %>
                        </span>
                      </div>
                      <% } %>
                  </div>
                </div>
                <% } %>

                  <!-- Leave a Review Form Card -->
                  <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm mb-10">
                    <% if (typeof reviewError !=='undefined' && reviewError) { %>
                      <div
                        class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm flex items-center gap-2">
                        <i class="fas fa-circle-exclamation"></i>
                        <span>
                          <%= reviewError %>
                        </span>
                      </div>
                      <% } %>

                        <% if (isLoggedIn) { %>
                          <h3 class="text-lg font-bold text-gray-900 mb-2 flex items-center gap-2">
                            <i class="fas fa-pen-to-square text-red-500"></i>
                            <%= typeof hasUserReviewed !=='undefined' && hasUserReviewed ? 'Share Another Review'
                              : 'Leave a Guest Review' %>
                          </h3>
                          <p class="text-xs text-gray-500 mb-4">How was your stay at <%= home.houseName %>? Help future
                              travelers by rating your experience.</p>

                          <form action="/homes/<%= home.id %>/reviews" method="POST" class="space-y-4">
                            <div>
                              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Overall
                                Rating *</label>
                              <div class="flex items-center gap-2" id="starPicker">
                                <% for (let star=1; star <=5; star++) { %>
                                  <label class="cursor-pointer">
                                    <input type="radio" name="rating" value="<%= star %>" class="sr-only peer"
                                      <%=star===5 ? 'checked' : '' %> />
                                    <i
                                      class="fas fa-star text-2xl text-amber-400 hover:scale-110 transition peer-checked:text-amber-500"></i>
                                  </label>
                                  <% } %>
                                    <span class="text-xs font-medium text-gray-500 ml-2" id="ratingLabel">5 Stars
                                      (Excellent)</span>
                              </div>
                            </div>

                            <div>
                              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Your
                                Experience & Feedback *</label>
                              <textarea name="comment" rows="3" required
                                placeholder="Tell other travelers about the location, cleanliness, host communication, and amenities..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 text-sm text-gray-800 placeholder-gray-400 resize-none"></textarea>
                            </div>

                            <div class="flex justify-end">
                              <button type="submit"
                                class="bg-red-500 hover:bg-red-600 text-white font-bold px-6 py-2.5 rounded-xl shadow-md transition duration-200 text-sm flex items-center gap-2 cursor-pointer">
                                <i class="fas fa-paper-plane text-xs"></i> Submit Review
                              </button>
                            </div>
                          </form>
                          <% } else { %>
                            <div
                              class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-gray-50 rounded-xl">
                              <div class="flex items-center gap-3">
                                <div
                                  class="w-10 h-10 rounded-full bg-red-100 text-red-500 flex items-center justify-center text-lg">
                                  <i class="fas fa-user-lock"></i>
                                </div>
                                <div>
                                  <h4 class="font-bold text-gray-800 text-sm">Want to leave a review?</h4>
                                  <p class="text-xs text-gray-500">Log in to your account to share your feedback for
                                    this stay.</p>
                                </div>
                              </div>
                              <a href="/login"
                                class="bg-red-500 hover:bg-red-600 text-white font-bold px-5 py-2 rounded-xl text-xs shadow transition">
                                Log In to Review
                              </a>
                            </div>
                            <% } %>
                  </div>

                  <!-- List of Guest Reviews -->
                  <% if (typeof reviews !=='undefined' && reviews.length> 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <% reviews.forEach(review=> { %>
                        <div
                          class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition">
                          <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-3">
                              <div
                                class="w-10 h-10 rounded-full bg-gradient-to-tr from-red-500 to-rose-400 text-white font-bold flex items-center justify-center text-base shadow-sm">
                                <%= review.user && review.user.name ? review.user.name.charAt(0).toUpperCase() : 'G' %>
                              </div>
                              <div>
                                <div class="font-bold text-gray-900 text-sm">
                                  <%= review.user ? review.user.name : 'Verified Guest' %>
                                </div>
                                <div class="text-[11px] text-gray-400">
                                  <%= new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short' ,
                                    day: 'numeric' , year: 'numeric' }) %>
                                </div>
                              </div>
                            </div>

                            <div class="flex items-center gap-2">
                              <!-- Star Icons -->
                              <div class="flex text-amber-400 text-xs">
                                <% for (let i=1; i <=5; i++) { %>
                                  <i
                                    class="fas fa-star <%= i <= review.rating ? 'text-amber-400' : 'text-gray-300' %>"></i>
                                  <% } %>
                              </div>

                              <!-- Delete Review Button for Author -->
                              <% if (user && review.userId===user.id) { %>
                                <form action="/reviews/<%= review.id %>/delete" method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this review?');"
                                  class="inline m-0">
                                  <input type="hidden" name="homeId" value="<%= home.id %>" />
                                  <button type="submit" title="Delete my review"
                                    class="text-gray-400 hover:text-red-500 text-xs p-1 transition cursor-pointer">
                                    <i class="fas fa-trash-can"></i>
                                  </button>
                                </form>
                                <% } %>
                            </div>
                          </div>

                          <p class="text-gray-700 text-sm leading-relaxed mt-2">
                            <%= review.comment %>
                          </p>
                        </div>
                        <% }) %>
                    </div>
                    <% } else { %>
                      <div class="text-center py-8 bg-gray-50 rounded-2xl border border-dashed border-gray-300">
                        <i class="fas fa-comments text-4xl text-gray-300 mb-2"></i>
                        <h4 class="font-bold text-gray-700 text-base">No reviews yet</h4>
                        <p class="text-xs text-gray-500 max-w-sm mx-auto mt-1">Be the first guest to share your thoughts
                          on this place!</p>
                      </div>
                      <% } %>
            </section>
          </div>
        </div>
      </main>

      <script>
        // Interactive Star Rating Picker enhancement
        const starInputs = document.querySelectorAll('input[name="rating"]');
        const ratingLabel = document.getElementById('ratingLabel');
        const labels = {
          1: '1 Star (Terrible)',
          2: '2 Stars (Poor)',
          3: '3 Stars (Average)',
          4: '4 Stars (Very Good)',
          5: '5 Stars (Excellent)'
        };

        if (starInputs && ratingLabel) {
          starInputs.forEach(input => {
            input.addEventListener('change', () => {
              ratingLabel.textContent = labels[input.value] || `${input.value} Stars`;
            });
          });
        }
      </script>

      <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
        <div class="container mx-auto px-4">
          <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
        </div>
      </footer>
  </body>

  </html>