<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen flex flex-col justify-between">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 max-w-6xl">
      <!-- Search & Filter Bar -->
      <div class="bg-white rounded-xl shadow-md p-6 mb-8 border border-gray-100">
        <h1 class="text-3xl font-extrabold text-gray-800 text-center mb-2">Find places to stay on Airbnb</h1>
        <p class="text-gray-500 text-center mb-6">Discover entire homes and private rooms perfect for any trip.</p>
        
        <form action="/" method="GET" class="max-w-2xl mx-auto flex flex-col sm:flex-row gap-3">
          <div class="relative flex-grow">
            <i class="fas fa-search absolute left-4 top-3.5 text-gray-400"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              placeholder="Search by city (e.g. Mumbai, Goa) or house name..." 
              class="w-full pl-11 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm text-gray-700"
            />
          </div>
          <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-lg transition duration-200 shadow flex items-center justify-center gap-2">
            <i class="fas fa-search"></i>
            Search
          </button>
          <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <a href="/" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium px-4 py-3 rounded-lg text-center transition">Clear</a>
          <% } %>
        </form>
      </div>

      <!-- Section Title -->
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">
          <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            Search Results for "<%= searchQuery %>" (<%= registeredHomes.length %>)
          <% } else { %>
            Featured Homes & Experiences
          <% } %>
        </h2>
        <a href="/homes" class="text-red-500 hover:text-red-600 font-semibold text-sm">View all homes &rarr;</a>
      </div>

      <% if (registeredHomes.length === 0) { %>
        <div class="bg-white rounded-xl p-12 text-center shadow-sm border border-gray-100">
          <i class="fas fa-home text-5xl text-gray-300 mb-4"></i>
          <h3 class="text-xl font-bold text-gray-700 mb-2">No homes found</h3>
          <p class="text-gray-500 mb-6">We couldn't find any listings matching your search. Try another location or keyword.</p>
          <a href="/" class="bg-red-500 text-white px-6 py-2.5 rounded-lg hover:bg-red-600 transition">View All Listings</a>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <% registeredHomes.forEach(home => { 
               const isFav = typeof favoriteIds !== 'undefined' && favoriteIds.includes(home.id.toString());
          %>
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group border border-gray-100">
              <!-- Image with Favorite Button -->
              <div class="relative overflow-hidden h-52">
                <a href="/homes/<%= home.id %>">
                  <img 
                    src="<%= home.photoUrl %>" 
                    alt="<%= home.houseName %>" 
                    onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=500';"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />
                </a>
                
                <!-- Favorite Toggle Button -->
                <form action="<%= isFav ? '/favorites/remove' : '/favorites/add' %>" method="POST" class="absolute top-3 right-3">
                  <input type="hidden" name="homeId" value="<%= home.id %>" />
                  <button 
                    type="submit" 
                    title="<%= isFav ? 'Remove from favorites' : 'Add to favorites' %>"
                    class="w-9 h-9 rounded-full bg-white/90 hover:bg-white shadow flex items-center justify-center transition">
                    <i class="fas fa-heart text-lg <%= isFav ? 'text-red-500' : 'text-gray-400 hover:text-red-400' %>"></i>
                  </button>
                </form>

                <div class="absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2.5 py-1 rounded-md backdrop-blur-sm">
                  <i class="fas fa-map-marker-alt text-red-400 mr-1"></i><%= home.location %>
                </div>
              </div>

              <!-- Card Body -->
              <div class="p-5 flex flex-col flex-grow justify-between">
                <div>
                  <div class="flex justify-between items-start mb-1">
                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-red-500 transition line-clamp-1">
                      <a href="/homes/<%= home.id %>"><%= home.houseName %></a>
                    </h3>
                    <div class="flex items-center text-sm font-semibold text-gray-800 ml-2">
                      <i class="fas fa-star text-yellow-400 mr-1"></i>
                      <span><%= (home.rating && home.rating !== 'New') ? home.rating : 'New' %></span>
                    </div>
                  </div>
                  <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= home.description || 'Charming property with modern decor, comfortable bedding, and convenient access to local attractions.' %></p>
                </div>

                <div>
                  <div class="text-lg font-bold text-red-500 mb-4">
                    ₹<%= Number(home.price).toLocaleString('en-IN') %> <span class="text-xs text-gray-500 font-normal">/ night</span>
                  </div>

                  <div class="grid grid-cols-2 gap-2">
                    <a 
                      href="/homes/<%= home.id %>" 
                      class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2 px-3 rounded-lg text-center transition text-sm flex items-center justify-center gap-1">
                      <i class="fas fa-info-circle text-xs"></i> Details
                    </a>
                    <a 
                      href="/reserve/<%= home.id %>" 
                      class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-3 rounded-lg text-center transition text-sm shadow flex items-center justify-center gap-1">
                      <i class="fas fa-calendar-alt text-xs"></i> Book Now
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-12 text-center text-sm text-gray-500">
      <div class="container mx-auto px-4">
        <p>&copy; 2026 Airbnb, Inc. All rights reserved &middot; Privacy &middot; Terms &middot; Sitemap</p>
      </div>
    </footer>
  </body>
</html>